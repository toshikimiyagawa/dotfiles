#!/bin/sh
#
# acn-devcontainer の Claude を、いまの herdr のペインで起動する。
#
#   acn-claude          一覧を fzf（ホスト）で選んで起動する。一覧の各行は「種類 対象」:
#                         container  <相対パス>   コンテナの ghq のリポジトリ
#                         workspace  <パス>       コンテナのワークスペース（既定 /workspaces/acn-devcontainer。ACN_WORKSPACE_DIR で変えられる）
#                         get        <相対パス>   ホストの ghq にだけあるリポジトリ（コンテナで ghq get してから起動する）
#                       git worktree（.git がファイルのもの）は一覧に出さない
#                       何も選ばなければ何もせずに終わる
#   acn-claude <dir>    コンテナの <dir> で起動する
#
# 接続先は ~/.ssh/config の Host（既定 acn-local。ACN_SSH_HOST で変えられる）。
# ssh の先の claude は herdr から見えないので、HERDR_AGENT=claude で
# 「このペインは Claude」と herdr に伝える（状態の表示・エージェントの切り替えに使われる）。
#
# ssh は Homebrew の openssh を使う。macOS 標準の /usr/bin/ssh は環境変数を
# 他のプロセスから読めず、herdr が HERDR_AGENT を見つけられないため。
#
# テストのため、外部コマンドを環境変数で差し替えられる:
#   ACN_SSH_BIN（既定 /opt/homebrew/bin/ssh）、ACN_FZF（既定 fzf）、ACN_GHQ（既定 ghq。ホストの ghq）、
#   ACN_HERDR（既定 herdr）
#
set -eu

host="${ACN_SSH_HOST:-acn-local}"
ssh_bin="${ACN_SSH_BIN:-/opt/homebrew/bin/ssh}"
fzf_bin="${ACN_FZF:-fzf}"
ghq_bin="${ACN_GHQ:-ghq}"
herdr_bin="${ACN_HERDR:-herdr}"
workspace="${ACN_WORKSPACE_DIR:-/workspaces/acn-devcontainer}"
if [ ! -x "${ssh_bin}" ]; then
  echo "acn-claude: ${ssh_bin} が無い（brew install openssh）。herdr が Claude と判定できない" >&2
  ssh_bin=ssh
fi

# リモートのシェルに渡すため、シングルクォートで囲む
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# リモートの claude の起動。herdr のペイン内では CLAUDE_MOBILE_PANE_ID にペイン ID を付ける
# （claude-mobile がペインと会話を対応付けるのに使う。sshd の AcceptEnv は変えず、リモートのコマンドで渡す）。
# herdr の外（HERDR_PANE_ID が空）では付けない
if [ -n "${HERDR_PANE_ID:-}" ]; then
  exec_claude="exec env CLAUDE_MOBILE_PANE_ID=$(quote "${HERDR_PANE_ID}") claude"
else
  exec_claude="exec claude"
fi

if [ $# -gt 0 ]; then
  remote="cd $(quote "$1") && ${exec_claude}"
  label_dir=$1
else
  # コンテナの ghq の一覧（端末は割り当てない）。git worktree（.git がファイル）は外す。
  # 繋がらなければ、ペインがすぐ閉じないように入力を待つ
  if ! container_list=$("${ssh_bin}" "${host}" 'cd "$(ghq root)" && ghq list | while IFS= read -r r; do [ -f "$r/.git" ] || printf "%s\n" "$r"; done' </dev/null); then
    echo "acn-claude: コンテナの ghq の一覧を取れなかった（コンテナが止まっている？）" >&2
    echo "Enter で閉じる" >&2
    read _ || :
    exit 1
  fi

  # ホストの ghq の一覧。失敗したら（ghq が無いときも）空として扱う。git worktree（.git がファイル）は外す
  host_list=$("${ghq_bin}" list 2>/dev/null) || host_list=
  host_root=$("${ghq_bin}" root 2>/dev/null) || host_root=
  if [ -n "${host_root}" ] && [ -n "${host_list}" ]; then
    host_list=$(printf '%s\n' "${host_list}" | while IFS= read -r r; do
      [ -f "${host_root}/${r}/.git" ] || printf '%s\n' "${r}"
    done)
  fi

  # container 行・workspace 行・get 行の順に並べる。
  # get はコンテナに無いものだけ。acn-devcontainer はワークスペースとして出すので除く
  list=$(
    {
      printf '%s\n' "${container_list}" | sed 's/^/C /'
      printf '%s\n' "${host_list}" | sed 's/^/H /'
    } | awk -v ws="${workspace}" '
      { t = substr($0, 1, 1); p = substr($0, 3) }
      p == "" { next }
      t == "C" { c[p] = 1; print "container  " p; next }
      t == "H" { h[++n] = p }
      END {
        print "workspace  " ws
        for (i = 1; i <= n; i++) {
          p = h[i]
          if (p in c) continue
          b = p; sub(/.*\//, "", b)
          if (b == "acn-devcontainer") continue
          print "get        " p
        }
      }'
  )

  sel=$(printf '%s\n' "${list}" | "${fzf_bin}" --prompt "repo> " --height 40% --reverse) || exit 0
  [ -n "${sel}" ] || exit 0

  kind=${sel%% *}
  target=$(printf '%s' "${sel#"${kind}"}" | sed 's/^ *//')

  label_dir=${target}
  case "${kind}" in
    container)
      remote="cd \"\$(ghq root)\"/$(quote "${target}") && ${exec_claude}"
      ;;
    workspace)
      remote="cd $(quote "${target}") && ${exec_claude}"
      ;;
    get)
      # URL はホストのリポジトリの remote.origin.url。取れなければ相対パスをそのまま渡す
      url=
      if [ -n "${host_root}" ]; then
        url=$(git -C "${host_root}/${target}" config --get remote.origin.url 2>/dev/null) || url=
      fi
      [ -n "${url}" ] || url=${target}
      remote="ghq get $(quote "${url}") || { echo \"acn-claude: ghq get に失敗した\"; echo \"Enter で閉じる\"; read _; exit 1; }; cd \"\$(ghq root)\"/$(quote "${target}") && ${exec_claude}"
      ;;
    *)
      echo "acn-claude: 分からない行: ${sel}" >&2
      exit 1
      ;;
  esac
fi

# herdr のエージェント一覧に「container」とフォルダ名を出す
# （$env と $dir。.config/herdr/config.toml の ui.sidebar.agents.rows）。herdr の外では何もしない
if [ -n "${HERDR_PANE_ID:-}" ] && command -v "${herdr_bin}" >/dev/null 2>&1; then
  "${herdr_bin}" pane report-metadata "${HERDR_PANE_ID}" --source acn-claude \
    --token env=container --token "dir=${label_dir##*/}" >/dev/null 2>&1 || :
fi

# COLORTERM を渡す（コンテナの sshd は AcceptEnv 済み）。無いと Claude が 256 色に落として色がずれる
exec env HERDR_AGENT=claude "${ssh_bin}" -t -o SendEnv=COLORTERM "${host}" "${remote}"
